# ============================================================
# Velix Sandbox Service — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# Port the sandbox service listens on (default: 3002)
SANDBOX_PORT=3002

# API key for authenticating requests from the backend.
# Leave empty to disable auth (local development mode).
# When set, all requests (except /health) must include:
#   Authorization: Bearer <this_key>
SANDBOX_API_KEY=

# --- Recommended: Supabase REST API (HTTPS, no direct Postgres needed) ---
# Use the same values as your backend .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional fallback if service role key is not set (not recommended for server use)
# SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Optional: Direct PostgreSQL connection (legacy fallback) ---
# Only needed if you are not using Supabase REST above.
# SANDBOX_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Upstash Redis REST URL (optional — enables compile history caching).
# Get this from: Upstash Dashboard → Your Redis → Endpoint
SANDBOX_UPSTASH_REDIS_REST_URL=

# Upstash Redis REST Token (optional — required if Redis URL is set).
# Get this from: Upstash Dashboard → Your Redis → API Keys → REST
SANDBOX_UPSTASH_REDIS_REST_TOKEN=

# Root directory for sandbox session files
# SANDBOX_ROOT_DIR=../backend/sandbox_env

# Plugins directory (compiler language configs)
# SANDBOX_PLUGINS_DIR=../backend/plugins

# --- Compile resource limits (tuned for Java/Maven Spigot plugins) ---
# Max JVM heap per compile process
SANDBOX_MAX_MEMORY_MB=1024
# Max total memory for Maven + Java child processes
SANDBOX_MAX_JOB_MEMORY_MB=1536
# CPU cap per compile job (percentage)
SANDBOX_MAX_CPU_PERCENT=75
# Max child processes Maven may spawn
SANDBOX_MAX_PROCESSES=32
# Max simultaneous compile jobs across all sessions
SANDBOX_MAX_CONCURRENT_COMPILES=2
# Stage timeouts (seconds)
SANDBOX_INSTALL_TIMEOUT=300
SANDBOX_COMPILE_TIMEOUT=180
SANDBOX_RUN_TIMEOUT=60

# Legacy single timeout override (applies to compile stage if set)
# SANDBOX_TIMEOUT=180

# Comma-separated list of allowed CORS origins
# SANDBOX_CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# --- Service manager ---
# Build once, then run:
#   go build -o velix-sandbox.exe ./cmd/velix-sandbox
#   velix-sandbox start|stop|restart|live-logs
