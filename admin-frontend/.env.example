# Admin frontend — separate Velix admin panel
PORT=3010

# Backend API base (no trailing slash)
BACKEND_URL=http://localhost:3006/api

# Shared secret sent as X-Admin-Api-Key on every proxied backend request.
# Must match ADMIN_API_KEY in backend/.env
ADMIN_API_KEY=your_admin_api_key_here

# Optional link back to the main user app
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000
