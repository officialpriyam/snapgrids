# Copy these into .env.local on the server.
# Admin settings are PostgreSQL-only; the app will not read/write storage/admin-settings.json.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Required before saving Paymenter API keys. Use a long random secret, 32+ chars.
ADMIN_ENCRYPTION_KEY="replace-with-a-long-random-secret"

POSTGRES_SSL="true"
